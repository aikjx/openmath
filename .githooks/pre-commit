# AUTO-GENERATED by scripts/install_cred_hooks.py — 请勿手改（重装会覆盖）。
# 链式 pre-commit：1) legacy(legacy.conf) 2) staged 凭据扫描。退出码取或。
repo_dir="$(git rev-parse --show-toplevel)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
default_py='C:\Users\mo\.workbuddy\binaries\python\versions\3.13.12\python.exe'
default_scan='D:\a10\aikjx\code\my_lib\scripts\secret_scan.py'
py="${SECRET_SCAN_PY:-$default_py}"
scan="${SECRET_SCAN:-$default_scan}"
rc=0
scan_blob() {
    _tf="$1"; _name="$2"
    if [ -f "$scan" ] && [ -f "$_tf" ]; then
        "$py" "$scan" --stdin --name "$_name" < "$_tf" || rc=1
    fi
}

conf="$repo_dir/.githooks/legacy.conf"
if [ -f "$conf" ]; then
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        ( cd "$repo_dir" && sh -c "$line" ) || rc=1
    done < "$conf"
fi

staged="$(git diff --cached --name-only --diff-filter=ACM)"
for f in $staged; do
    [ -n "$f" ] || continue
    case "$f" in .githooks/*|*legacy.conf) continue ;; esac
    tf="$tmpdir/staged.blob"
    git show ":$f" > "$tf" 2>/dev/null || continue
    scan_blob "$tf" "$f"
done
exit $rc
